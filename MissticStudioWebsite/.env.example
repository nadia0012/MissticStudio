# =============================================
# CONFIGURATION EMAIL
# =============================================

# OPTION 1: Gmail (pour développement/test)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# EMAIL_TO=votre-email-perso@gmail.com

# OPTION 2: Planethoster (production)
# SMTP_HOST=mail.planethoster.net
# SMTP_PORT=587
# SMTP_USER=your-planethoster-email@missticstudio.com
# SMTP_PASS=your-planethoster-password
# EMAIL_TO=contact@missticstudio.com

# =============================================
# SÉCURITÉ
# =============================================
FORM_SECRET=your-random-secret-key-here

# =============================================
# reCAPTCHA v3 (optionnel)
# =============================================
# Inscrivez-vous sur https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET=your-recaptcha-secret-key-here
