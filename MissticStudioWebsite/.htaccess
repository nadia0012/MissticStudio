# =====================================================
# AUGMENTER LES LIMITES D'UPLOAD DE FICHIERS
# =====================================================
php_value upload_max_filesize 50M
php_value post_max_size 50M
php_value max_file_uploads 20

# =====================================================
# SÉCURITÉ ET OPTIMISATION
# =====================================================
# Désactiver l'affichage des erreurs en production
php_flag display_errors Off
php_flag log_errors On

# Délai d'exécution max
php_value max_execution_time 60

# Mémoire max pour un script
php_value memory_limit 256M

RewriteEngine On

# Redirige /index.html vers / (URL propre pour la page d'accueil)
RewriteRule ^index\.html$ https://www.missticstudio.com/ [R=301,L]

# Redirige les .html vers l'URL sans extension
RewriteCond %{THE_REQUEST} \s/(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Affiche le bon fichier .html sans changer l'URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.html [NC,L]